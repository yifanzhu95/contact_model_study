#!/bin/bash -l
#PBS -N kamino_stage
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -r y
#PBS -m n
set -euo pipefail

: "${PROJ_DIR:?}" "${ENV_DIR:?}" "${OUTDIR:?}" "${EXPECTED_SHA:?}"
: "${ALCF_PROJECT:?}" "${PBS_JOBID:?}" "${STAGE:?}" "${PREVIOUS_VERDICT:?}" "${NSAMPLES:?}"
mkdir -p "$OUTDIR"
stage_pid=""
finalize() {
    job_rc=$?
    trap - EXIT
    set +e
    "$ENV_DIR/bin/python" "$PROJ_DIR/experiments/polaris/collect_manifest.py" \
        --outdir "$OUTDIR" --job-exit-code "$job_rc"
    exit "$job_rc"
}
stop_stage() {
    trap '' TERM INT
    if [[ -n "$stage_pid" ]]; then
        kill -TERM "$stage_pid" 2>/dev/null || true
        wait "$stage_pid" || true
    fi
    exit 143
}
trap finalize EXIT
trap stop_stage TERM INT
set +u
module use /soft/modulefiles
module load conda
conda activate "$ENV_DIR"
set -u
export PYTHONNOUSERSITE=1 MUJOCO_GL=egl OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export CUDA_VISIBLE_DEVICES=0,1,2,3
if [[ "$STAGE" == g1 ]]; then export CUDA_VISIBLE_DEVICES=0; fi
export TMPDIR="/local/scratch/${USER}/kamino_${PBS_JOBID}"
export WARP_CACHE_PATH="$TMPDIR/warp-cache"
mkdir -p "$TMPDIR" "$WARP_CACHE_PATH"
cd "$PROJ_DIR"
python experiments/polaris/preflight.py --repo "$PROJ_DIR" --outdir "$OUTDIR" \
    --expected-sha "$EXPECTED_SHA" --gpus "$CUDA_VISIBLE_DEVICES" --output "$OUTDIR/preflight.json"
python -m pip check > "$OUTDIR/pip-check.txt"
python -m pip freeze --all > "$OUTDIR/pip-freeze.txt"
conda list --explicit > "$OUTDIR/conda-explicit.txt"
options=()
if [[ "$STAGE" != g1 ]]; then options+=(--n-samples "$NSAMPLES"); fi
python experiments/polaris/run_stage.py "$STAGE" --outdir "$OUTDIR" \
    --expected-sha "$EXPECTED_SHA" --previous "$PREVIOUS_VERDICT" \
    --budget-seconds 3000 --resume "${options[@]}" &
stage_pid=$!
wait "$stage_pid"
