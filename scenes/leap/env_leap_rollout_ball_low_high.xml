<mujoco model="right_leap_hand scene">
  <include file="./leap_right_hand_low.xml"/>
  <!-- Planner-side scene: identical to env_leap_eval_ball.xml except for the
  hand include above, which sets the collision fidelity of the PLANNER's hand.
  The trailing "_high" in this filename is the object-accuracy axis, which is
  degenerate for a ball: a sphere primitive is exact in every contact model, so
  there is nothing to degrade and no _low/_med object variant exists. -->

  <statistic center="0 0 0" extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="130" elevation="-40" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <!-- A bare sphere renders as a featureless blob, which makes a REORIENTATION
    task impossible to read: nothing on the surface shows how the object turned.
    So the ball wears a builtin cube-mapped checker with a cross mark, which puts
    a distinct pattern on every side. type="cube" (not "2d") is what lets a
    texture wrap a sphere without a UV-mapped mesh, and texuniform="true" keeps
    the cell size constant regardless of geom size. No file needed — the texture
    is generated by the compiler, so this scene pulls in no new assets. -->
    <texture type="cube" name="ball_surface" builtin="checker" mark="cross"
      rgb1="0.15 0.35 0.75" rgb2="0.92 0.92 0.92" markrgb="0.97 0.75 0.1"
      width="256" height="256"/>
    <material name="obj_material" texture="ball_surface" texuniform="true"
      specular="0.3" shininess="0.4"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0."/>
  </asset>

  <worldbody>
    <light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8"  castshadow="false" pos="0 1 4" dir="0 0 -1" name="light0"/>
    <camera name="demo-cam" pos="-0.003 -0.393 0.317" xyaxes="1.000 -0.000 0.000 0.000 0.462 0.887"/>

    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Reorientation target marker. mocap="true" so the task's _update_goal can
    rewrite its orientation each time a new goal is sampled (MuJoCo drives it via
    mjd.mocap_quat; the Pinocchio viewer via PinocchioSimulator.set_goal_quat).
    pos is the cube scene's proven upper-left inset placement for the eval camera
    (_CAM_POS/_CAM_ROTMAT in tasks/grasp_reorient.py). The marker radius is the
    ball's 0.0485 scaled by the cube scene's 0.015/0.035 goal-to-object ratio,
    so this inset reads at the same size as the cube scene's. Visual only
    (contype/conaffinity 0, density 0): it never collides and carries no mass. -->
    <body name="goal" pos="0.005 -0.07 0.1353" quat="1 0 0 0" mocap="true">
      <geom name="goal_visual" type="sphere" size="0.0208" material="obj_material"
        contype="0" conaffinity="0" density="0"/>
    </body>

    <body name="obj" pos="0 0.05 0.0835">
        <freejoint name="obj_joint"/>
        <!-- One geom does both jobs here: a sphere primitive is exact, so unlike
        the duck/spam/tomato scenes there is no mesh to hide behind a separate
        collision hull, and unlike the cube scene no UV-mapped mesh is needed to
        carry the texture. mass="0.14" matches the cube's, making the ball the
        cube's mass with a rounder shape rather than a second variable; MuJoCo
        derives the inertia from the sphere (2/5 m r^2 = 1.32e-4). Set `mass` to
        reweight — inertia follows automatically.

        Body pos: the cube rests with its underside at z = 0.07 - 0.035 = 0.035,
        so a ball sitting on that same palm height centres at 0.035 + 0.0485.
        This is only the settling/viewer pose — a run's actual reset state comes
        from _OBJ_PARAMS["ball"]["init_qpos"] in tasks/grasp_reorient.py. -->
        <geom name="obj" type="sphere" size="0.0485" material="obj_material"
              friction="0.5" mass="0.14"/>
    </body>

  </worldbody>
</mujoco>
