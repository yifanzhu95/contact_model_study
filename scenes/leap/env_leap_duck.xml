<mujoco model="right_allegro_hand scene">
  <include file="./leap_right_hand.xml"/>

  <statistic center="0 0 0" extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="130" elevation="-40" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture name='cube_surface' file="./textures/iris_block.png" gridsize="3 4" gridlayout=".U..LFRB.D.."/>
    <material name="obj_material" texture="cube_surface" specular="5" shininess=".0"/>
    
    <mesh name="rubber_duck_mesh" file="../../objects/rubber_duck.stl" maxhullvert="30"/>
    <!-- <mesh name="rubber_duck_mesh" file="../../objects/duck_adjusted.obj"/> -->
    
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0."/>
  </asset>

  <worldbody>
    <light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8"  castshadow="false" pos="0 1 4" dir="0 0 -1" name="light0"/>
    <camera name="demo-cam" pos="-0.003 -0.393 0.317" xyaxes="1.000 -0.000 0.000 0.000 0.462 0.887"/>

    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="goal" pos="-0.01 -0.1 0.2" quat="0.707 0 0 -0.707">
      <geom name="goal-visual-above" type="mesh" mesh="rubber_duck_mesh" conaffinity="0" contype="0"
        pos="0 0 0" quat="1 0 0 0" rgba="0.97 0.6 0 0.3"/>
    </body>
    
    <body name="obj" pos="0.02 0.05 0.1">
        <freejoint name="obj_joint"/>
        <!-- Explicit inertia, overriding the geom's mass="0.1". pos/quat are the
        convex hull's COM and principal axes; mass and diaginertia are both
        halved so the duck stays a uniform-density solid at half the weight. -->
        <inertial pos="-0.0088373 -0.0000005 -0.0151651"
                  quat="0.6887911 0.1598961 0.1598961 0.6887911"
                  mass="0.05" diaginertia="4.594933e-05 3.722781e-05 2.626221e-05"/>
        <geom name="obj" type="mesh" mesh="rubber_duck_mesh" 
              friction="0.5" mass="0.1" rgba="0.97 0.6 0 1.0"/>
    </body>
    
  </worldbody>
</mujoco>
