<mujoco model="right_allegro_hand scene">
  <include file="./leap_right_hand_low.xml"/>

  <statistic center="0 0 0" extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="130" elevation="-40" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <mesh name="object" file="../../objects/tomatoSoupTin.stl" maxhullvert="30"/>
    <mesh name="object_small" file="../../objects/tomatoSoupTin.stl" scale="0.5 0.5 0.5" maxhullvert="30"/>
    <texture name='surface' file="./textures/general_block.png" gridsize="3 4" gridlayout=".U..LFRB.D.."/>
    <material name="obj_material" texture="surface" specular="5" shininess=".0"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0."/>
  </asset>

  <worldbody>
    <light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8"  castshadow="false" pos="0 1 4" dir="0 0 -1" name="light0"/>
    <camera name="demo-cam" pos="-0.003 -0.393 0.317" xyaxes="1.000 -0.000 0.000 0.000 0.462 0.887"/>

    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Reorientation target marker. mocap="true" is REQUIRED: the task's
    _update_goal rewrites mjd.mocap_quat here each time a goal is sampled, and
    silently does nothing on a non-mocap body. Visual only, so density="0"
    keeps the marker mesh out of the mass properties. -->
    <body name="goal" pos="-0.01 -0.1 0.2" quat="1 0 0 0" mocap="true">
      <geom name="goal-visual-above" type="mesh" mesh="object_small"  conaffinity="0" contype="0" density="0" material="obj_material"
        pos="0 0 0" quat="1 0 0 0" rgba="1.0 1.0 0 0.3" fitscale="0.5"/>
    </body>
    
    <body name="obj" pos="-0.00 0.05 0.07">
      <freejoint name="obj_joint"/>
      <geom name="obj" type="mesh" mesh="object" 
          quat="1 0 0 0" friction="0.5" rgba="1.0 1.0 0 0.99" mass="0.14" material="obj_material"/>
    </body>
    
  </worldbody>
</mujoco>
